VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Optional: keep disabled and do not enable in production unless temporarily troubleshooting
VITE_ENABLE_DEBUG_DIAGNOSTICS=false
# Optional server-side alias when configured in Cloudflare Workers
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
AIRTABLE_API_KEY=your-airtable-api-key
AIRTABLE_BASE_ID=your-airtable-base-id
AIRTABLE_TABLE_JOBS=your-airtable-jobs-table-id
AIRTABLE_TABLE_CLIENTS=your-airtable-clients-table-id
AIRTABLE_TABLE_SERVICE_CATALOG=your-airtable-service-catalog-table-id
AIRTABLE_TABLE_ACCOUNTANTS=your-airtable-accountants-table-id
AIRTABLE_TABLE_MESSAGES=your-airtable-messages-table-id
PLAUSIBLE_API_KEY=your-plausible-api-key
# Shared secret checked against the X-Lead-Intake-Secret header on
# /webhooks/lead-intake (WebhookLeadIntake ticket). Generate a long random
# value, set it here AND as the header value in the Make HTTP module -
# never commit the real value.
LEAD_INTAKE_SECRET=your-long-random-shared-secret

# Refresh button on the Correspondence view of /leads. The portal POSTs to the
# n8n Gmail sync webhook with the secret in the X-Mgt-Portal-Secret header.
# Both are unset today: n8n workflow uSQOKDb9YLNxiIIT has a schedule trigger
# only, so until it gains a webhook trigger the button stays disabled and says
# why. Set the real values as Cloudflare secrets, never here.
N8N_GMAIL_SYNC_URL=https://n8n.example.com/webhook/your-path
N8N_GMAIL_SYNC_SECRET=your-long-random-shared-secret
